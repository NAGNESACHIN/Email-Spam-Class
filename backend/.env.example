ENVIRONMENT=development
DATABASE_URL=sqlite:///./mailguard.db
JWT_SECRET=replace-with-a-long-random-secret
CORS_ORIGINS=http://localhost:5173
# Production PostgreSQL example:
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/mailguard

# Optional URL reputation enrichment
VIRUSTOTAL_API_KEY=

# Authentication throttling (per IP and per email)
AUTH_RATE_WINDOW_SECONDS=300
AUTH_RATE_LIMIT=10

# Live public domain-registration intelligence (RDAP)
RDAP_LOOKUP_ENABLED=true
# PostgreSQL pool tuning (ignored by SQLite)
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
